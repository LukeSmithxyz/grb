#!/bin/sh

cmd="$@"

first="${cmd%/*}"

if [ "$first" = "$cmd" ]; then
	grb "${cmd#grb }"
	exit
fi

search="${cmd#*/}"
IFS='
'

repl="$(while read -n 1 char; do
	case "$char" in
	α|ὰ|ά|ἀ|ἁ|ἂ|ἃ|ἄ|ἅ|ἆ|ἇ|ᾀ|ᾁ|ᾂ|ᾃ|ᾄ|ᾅ|ᾆ|ᾇ|ᾰ|ᾱ|ᾲ|ᾳ|ᾴ|ᾶ|ᾷ) printf "[αὰάἀἁἂἃἄἅἆἇᾀᾁᾂᾃᾄᾅᾆᾇᾰᾱᾲᾳᾴᾶᾷ]" ;;
	Α|Ἀ|Ἁ|Ἂ|Ἃ|Ἄ|Ἅ|Ἆ|Ἇ|ᾈ|ᾉ|ᾊ|ᾋ|ᾌ|ᾍ|ᾎ|ᾏ|Ᾰ|Ᾱ|Ὰ|Ά|ᾼ) printf "[ΑἈἉἊἋἌἍἎἏᾈᾉᾊᾋᾌᾍᾎᾏᾸᾹᾺΆᾼ]" ;;
	ε|ὲ|έ|ἐ|ἑ|ἒ|ἓ|ἔ|ἕ) printf "[εὲέἐἑἒἓἔἕ]" ;;
	Ε|Ὲ|Έ|Ἐ|Ἑ|Ἒ|Ἓ|Ἔ|Ἕ) printf "[ΕῈΈἘἙἚἛἜἝ]" ;;
	η|ὴ|ή|ἠ|ἡ|ἢ|ἣ|ἤ|ἥ|ἦ|ἧ|ᾐ|ᾑ|ᾒ|ᾓ|ᾔ|ᾕ|ᾖ|ᾗ|ῂ|ῃ|ῄ|ῆ|ῇ) printf "[ηὴήἠἡἢἣἤἥἦἧᾐᾑᾒᾓᾔᾕᾖᾗῂῃῄῆῇ]" ;;
	Η|Ἠ|Ἡ|Ἢ|Ἣ|Ἤ|Ἥ|Ἦ|Ἧ|ᾘ|ᾙ|ᾚ|ᾛ|ᾜ|ᾝ|ᾞ|ᾟ|Ὴ|Ή|ῌ) printf "[ΗἨἩἪἫἬἭἮἯᾘᾙᾚᾛᾜᾝᾞᾟῊΉῌ]" ;;
	ι|ῐ|ῑ|ῒ|ΐ|ῖ|ῗ|ὶ|ί|ἰ|ἱ|ἲ|ἳ|ἴ|ἵ|ἶ|ἷ) printf "[ιῐῑῒΐῖῗὶίἰἱἲἳἴἵἶἷ]" ;;
	Ι|Ἰ|Ἱ|Ἲ|Ἳ|Ἴ|Ἵ|Ἶ|Ἷ|Ῐ|Ῑ|Ὶ|Ί) printf "[ΙἸἹἺἻἼἽἾἿῘῙῚΊ]" ;;
	ο|ὸ|ό|ὀ|ὁ|ὂ|ὃ|ὄ|ὅ) printf "[οὸόὀὁὂὃὄὅ]" ;;
	Ο|Ὸ|Ό|Ὀ|Ὁ|Ὂ|Ὃ|Ὄ|Ὅ) printf "[ΟῸΌὈὉὊὋὌὍ]" ;;
	υ|ὺ|ύ|ύ|ὐ|ὑ|ὒ|ὓ|ὔ|ὕ|ὖ|ὗ|ῦ|ῧ|ῠ|ῡ|ῢ|ΰ) printf "[υὺύύὐὑὒὓὔὕὖὗῦῧῠῡῢΰ]" ;;
	Υ|Ὑ|Ὓ|Ὕ|Ὗ|Ῠ|Ῡ|Ὺ|Ύ) printf "[ΥὙὛὝὟῨῩῪΎ]" ;;
	ω|ὠ|ὡ|ὢ|ὣ|ὤ|ὥ|ὦ|ὧ|ῲ|ῳ|ῴ|ῶ|ῷ|ὼ|ώ|ᾠ|ᾡ|ᾢ|ᾣ|ᾤ|ᾥ|ᾦ|ᾧ) printf "[ωὠὡὢὣὤὥὦὧῲῳῴῶῷὼώᾠᾡᾢᾣᾤᾥᾦᾧ]" ;;
	Ω|Ὠ|Ὡ|Ὢ|Ὣ|Ὤ|Ὥ|Ὦ|Ὧ|ᾨ|ᾩ|ᾪ|ᾫ|ᾬ|ᾭ|ᾮ|ᾯ|Ὼ|Ώ|ῼ) printf "[ΩὨὩὪὫὬὭὮὯᾨᾩᾪᾫᾬᾭᾮᾯῺΏῼ]" ;;
	ρ|ῤ|ῥ) printf "[ρῤῥ]" ;;
	Ρ|Ῥ) printf "[ΡῬ]" ;;
	σ|ς) printf "[σς]" ;;
		*) printf "%s" "$char" ;;
	esac
done <<< "$search")"

grb "${first#grb } /$repl"
